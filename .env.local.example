# GhostWire Terminal Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# ============================================
# GROQ API Configuration (for AI Partner Alex)
# ============================================
# 1. Get your free Groq API key from: https://console.groq.com
# 2. Copy the API key and paste below
# 3. Model options: mixtral-8x7b-32768, llama-3-70b-8192, etc.

VITE_GROQ_API_KEY=
VITE_GROQ_API_URL=https://api.groq.com/openai/v1
VITE_GROQ_MODEL=mixtral-8x7b-32768

# ============================================
# OpenAI API Configuration (internet AI fallback)
# ============================================
# 1. Get your OpenAI API key from: https://platform.openai.com
# 2. Copy the API key and paste below
# 3. Model options: gpt-3.5-turbo, gpt-4o-mini, gpt-4o, etc.

VITE_OPENAI_API_KEY=
VITE_OPENAI_API_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# SUPABASE Configuration (optional, for online presence)
# ============================================
# Leave empty if you don't need online presence tracking

# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
